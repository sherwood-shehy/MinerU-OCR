# Copy this file to .env and fill in your real credentials.
# Never commit a real .env file — it is gitignored for safety.

# === MinerU Cloud OCR (required) ===
# Obtain from https://mineru.net/apiManage
MINERU_API_TOKEN=<your_mineru_api_token>

# === AI Enhancement Layer ===
# Configure Doubao privately with:
#   mineru-ocr config set-doubao-key
# Enter: 你的豆包apikey
#
# Defaults are stored in the local user config when the key is saved:
#   base_url = https://ark.cn-beijing.volces.com/api/coding/v3
#   model = doubao-seed-2.0-lite
